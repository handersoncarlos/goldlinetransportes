{
  "name": "goldline-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "zip": "rm -f goldline-v2-hostinger.zip && cd dist && zip -r -X -q ../goldline-v2-hostinger.zip . -x \"*.DS_Store\"",
    "images": "node scripts/images.mjs && node scripts/clientes.mjs",
    "map": "node scripts/map.mjs",
    "verify:shots": "node scripts/verify-shots.mjs",
    "verify:func": "node scripts/verify-functional.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.3.3"
  }
}
